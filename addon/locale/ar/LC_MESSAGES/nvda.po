#. Translators: Script category for Subtitle Reader
#. Add-on summary, usually the user visible name of the addon.
#. Translators: Summary for this add-on
#. to be shown on installation and add-on information found in Add-ons
#. Manager.
#: addon\globalPlugins\subtitle_reader\__init__.py:38 buildVars.py:23
msgid "Subtitle reader"
msgstr "قراءة الترجمات Subtitle"

#. Translators: This will be displayed when the reader switch is turned on
#: addon\globalPlugins\subtitle_reader\__init__.py:108
msgid "Subtitle reader on"
msgstr "البدء في قراءة الترجمات subtitles"

#. Translators: This will be displayed when the reader switch is turned off
#: addon\globalPlugins\subtitle_reader\__init__.py:112
msgid "Subtitle reader off"
msgstr "التوقف عن قراءة الترجمات subtitles"

#. Translators: Reader's toggle switch
#: addon\globalPlugins\subtitle_reader\__init__.py:117
msgid "Enable or disable subtitle reader"
msgstr "تبديل القراءة"

#. Translators: Subtitle Reader menu on the NVDA tools menu
#: addon\globalPlugins\subtitle_reader\gui.py:18
msgid "Subtitle reader (&R)"
msgstr "قراءة الترجمات Subtitle"

#. Translators: Reader toggle switch on the Subtitle Reader menu
#: addon\globalPlugins\subtitle_reader\gui.py:20
msgid "Enable or disable subtitle reader (&S)"
msgstr "تبديل القراءة"

#. Translators: toggle reading when video window not in foreground on the
#. Subtitle Reader menu
#: addon\globalPlugins\subtitle_reader\gui.py:24
msgid "Reading in the background (&B)"
msgstr "القراءة في الخلفية"

#: addon\globalPlugins\subtitle_reader\gui.py:28
msgid "Youtube settings"
msgstr "إعدادات يوتيوب"

#. Translators: toggle Youtube menu item whether to read the chat message when
#. the new chat message already appeared
#: addon\globalPlugins\subtitle_reader\gui.py:31
msgid "Read chat (&R)"
msgstr "قراءة الدردشة"

#. Translators: toggle Youtube menu item whether to read the chat message
#. sender.
#: addon\globalPlugins\subtitle_reader\gui.py:35
msgid "Read the sender's name (&A)"
msgstr "قراءة اسم مرسل الرسالة"

#. Translators: toggle Youtube menu item whether to read the chat gift sponser
#. message.
#: addon\globalPlugins\subtitle_reader\gui.py:39
msgid "Read gift sent (&G)"
msgstr "قراءة تم إرسال الهدية"

#. Translators: toggle Youtube menu item whether to omit graphic when reading
#. the chats
#: addon\globalPlugins\subtitle_reader\gui.py:43
msgid "Skip the picture name when reading the chat (&G)"
msgstr "تجاهل الرسومات في قراءة الدردشة"

#. Translators: toggle menu item whether to prompt wher Youtube info card is
#. already appear
#: addon\globalPlugins\subtitle_reader\gui.py:47
msgid "Information cards (&I)"
msgstr "بطاقات المعلومات السريعة"

#. Translators: This menu item performs a check for updates to the reader
#: addon\globalPlugins\subtitle_reader\gui.py:55
msgid "Check for updates (&C)"
msgstr "البحث عن التحديثات"

#. Translators: This menu item that can toggle automatic check for update when
#. Subtitle Reader is start
#. Translators: This is Menu item that can toggle automatic check for update
#. on Subtitle Reader is start
#: addon\globalPlugins\subtitle_reader\gui.py:59
#: addon\globalPlugins\subtitle_reader\update.py:62
msgid "Check for updates automatically (&A)"
msgstr "البحث التلقائي عن التحديثات"

#: addon\globalPlugins\subtitle_reader\gui.py:65
msgid "Subtitle reader V"
msgstr "قراءة الترجمات Subtitle V"

#: addon\globalPlugins\subtitle_reader\gui.py:65
msgid " Version information"
msgstr "معلومات الإصدار"

#. Translators: This label means the edit box content is changelog
#: addon\globalPlugins\subtitle_reader\gui.py:68
msgid "Change log"
msgstr "سجل التغييرات"

#. Translators: This button means now run the update process
#: addon\globalPlugins\subtitle_reader\gui.py:72
msgid "Update now (&U)"
msgstr "تحديث الآن"

#. Translators: This button means that the automatic check for updates will
#. skip this version
#: addon\globalPlugins\subtitle_reader\gui.py:74
msgid "Skip this version (&S)"
msgstr "تخطى هذا الإصدار"

#. Translators: This button means close window until next automatic or manual
#. check for update
#: addon\globalPlugins\subtitle_reader\gui.py:76
msgid "Later (&L)"
msgstr "لاحقاً"

#. Translators: This is a prompt to confirm that the reader is the latest
#. version
#: addon\globalPlugins\subtitle_reader\update.py:129
msgid "You have updated to the latest version, enjoy using it!"
msgstr "لقد قمت بالترقية إلى أحدث إصدار ، استمتع بالفيديو."

#: addon\globalPlugins\subtitle_reader\update.py:129
msgid "congratulations"
msgstr "تهانينا"

#. Translators: This is the prompt when checking for updates fails
#: addon\globalPlugins\subtitle_reader\update.py:134
msgid "Unable to check for updates"
msgstr "فشل البحث عن التحديثات"

#: addon\globalPlugins\subtitle_reader\update.py:134
#: addon\globalPlugins\subtitle_reader\update.py:177
msgid "Error"
msgstr "خطأ"

#. Translators: This is the prompt when downloading updates fails
#: addon\globalPlugins\subtitle_reader\update.py:177
msgid "The update download has failed"
msgstr "فشل تنزيل التحديث"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on
#. information from add-ons manager
#: buildVars.py:26
msgid ""
"This add-on let NVDA read out the subtitles when the focus is on the movie "
"player on the Web page."
msgstr "دعم قراءة الترجمات المصاحبة Subtitle  لفيديوهات الأنترنت بستخدام NVDA"
